#!/usr/sbin/nft -f
# Managed by Ansible (deploy/site.yml). Incoming: only SSH, HTTP and HTTPS.
# Only this table is replaced on reload (no "flush ruleset"), so Podman's own
# rules for container networking are left alone.

table inet santa
delete table inet santa

table inet santa {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		meta l4proto { icmp, ipv6-icmp } accept
		# At most ~30 new web connections a second per address (bursts of 60),
		# dropped before nginx spends any work on them.
		tcp dport { 80, 443 } ct state new meter santa_web4 { ip saddr limit rate over 30/second burst 60 packets } drop
		tcp dport { 80, 443 } ct state new meter santa_web6 { ip6 saddr limit rate over 30/second burst 60 packets } drop
		tcp dport { {{ santa_ssh_port }}, 80, 443 } accept
	}
}
