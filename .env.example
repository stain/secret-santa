# Copy to .env on the server and fill in. Never commit .env.

# The public address; DNS for it must point at this server.
DOMAIN=santa.s11.no
PUBLIC_URL=https://santa.s11.no

# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=

# Named in the privacy notice as the processor running the server.
HOSTING_PROVIDER=UpCloud Ltd
HOSTING_LOCATION=Helsinki, Finland

# Days to keep nightly SQL dumps (0 = none).
BACKUP_DAYS=7
