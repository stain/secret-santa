{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-santa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-santa",
      // Replace with the id printed by `npx wrangler d1 create secret-santa`.
      // Local development works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Delete groups past their end date, daily at 03:17 UTC (GDPR storage limitation).
  "triggers": { "crons": ["17 3 * * *"] },
  // Request logs would record participants' private links and visitors' IP
  // addresses, so Workers Logs stay off. `npx wrangler tail` still shows live logs.
  "observability": { "enabled": false }
}
