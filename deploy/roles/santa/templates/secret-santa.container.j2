# Managed by Ansible (deploy/site.yml). Podman Quadlet: systemd turns this
# into secret-santa.service, which runs the app container.

[Unit]
Description=Secret Santa
Wants=network-online.target
After=network-online.target
# Never give up restarting: the growing delay below keeps a crash loop cheap,
# and the app comes back by itself once the cause (e.g. a full disk) is gone.
StartLimitIntervalSec=0

[Container]
Image=localhost/secret-santa:latest
# The image is uploaded by Ansible, never downloaded from a registry.
Pull=never
ContainerName=secret-santa
EnvironmentFile=/etc/secret-santa/secret-santa.env
Environment=NODE_ENV=production PORT=8787 DATA_DIR=/data TZ=UTC
# Node's heap stays below the container's memory limit, so running out of
# memory ends in a clean "heap out of memory" exit and a restart.
Environment=NODE_OPTIONS=--max-old-space-size=192
# Only nginx, on this host, can reach it.
PublishPort=127.0.0.1:8787:8787
# Runs as a uid no login user has; it owns the database and nightly dumps.
User={{ santa_app_uid }}:{{ santa_app_uid }}
Volume=/var/lib/secret-santa:/data
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PodmanArgs=--memory=256m --pids-limit=100
LogDriver=journald
# If the app stops answering (hung, not crashed), kill it so systemd restarts it.
HealthCmd=node -e "fetch('http://127.0.0.1:8787/robots.txt').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
HealthStartPeriod=60s
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
# Restart after 10 s, then wait longer after each further failure, up to 5 min.
RestartSec=10s
RestartSteps=5
RestartMaxDelaySec=5min
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
