# Managed by Ansible (deploy/site.yml): local changes are overwritten.
# nginx in front of the Secret Santa app (127.0.0.1:8787) for {{ santa_domain }}.
# The front page, privacy notice and assets are files in /var/www/santa-static
# (copied out of the app image); everything else goes to the app.

# --- Limits per client address, and in total (429 when exceeded) ---
limit_req_zone $binary_remote_addr zone=santa_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=santa_admin:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=santa_lookup:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=santa_join:10m rate=20r/m;
limit_conn_zone $binary_remote_addr zone=santa_conn:10m;
limit_conn_zone $server_name zone=santa_total:1m;
limit_req_status 429;
limit_conn_status 429;

# --- The only request log: address and status of requests refused for going
# over the limits (429) or for the wrong name (444), for fail2ban. No URLs.
# Kept for one day (logrotate). ---
map $status $santa_limited {
    429 1;
    444 1;
    default 0;
}
log_format santa_limits '$remote_addr $status';

# --- Language of the static pages: the `lang` cookie (set by the flags), or
# else the browser's first supported language ---
map $http_accept_language $santa_accept_lang {
    default en;
    "~*^\s*(nb|nn|no)\b" nb;
    "~*^\s*es\b" es;
    "~*^\s*en\b" en;
    "~*\b(nb|nn|no)\b" nb;
    "~*\bes\b" es;
}
map $cookie_lang $santa_lang {
    en en;
    es es;
    nb nb;
    default $santa_accept_lang;
}

# Requests for any other name (e.g. scanners using the bare IP address) get
# nothing: no answer on HTTP, a refused handshake on HTTPS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log /var/log/nginx/santa-limits.log santa_limits if=$santa_limited;
    return 444;
}
{% if santa_https_ready %}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    access_log off;
    ssl_reject_handshake on;
}
{% endif %}

# Port 80: Let's Encrypt's checks, and a redirect to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name {{ santa_domain }};
    access_log /var/log/nginx/santa-limits.log santa_limits if=$santa_limited;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        limit_req zone=santa_general burst=40 nodelay;
{% if santa_https_ready %}
        return 301 https://$host$request_uri;
{% else %}
        # No certificate yet: only Let's Encrypt's checks are answered.
        return 404;
{% endif %}
    }
}
{% if santa_https_ready %}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ santa_domain }};

{% if santa_tls_internal %}
    # Self-signed certificate (test VMs only).
    ssl_certificate /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
{% else %}
    ssl_certificate /etc/letsencrypt/live/{{ santa_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ santa_domain }}/privkey.pem;
{% endif %}
    # TLS 1.2 and 1.3 with forward-secret (ECDHE) ciphers only; no session
    # tickets, so a leaked ticket key can't decrypt recorded sessions.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:santa_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Headers for the app's responses (the app sets the rest itself). The
    # static locations below include snippets/santa-headers.conf instead,
    # because an add_header in a location replaces these.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    server_tokens off;

    # Privacy: only the limit log above; only critical errors, which don't
    # include request URLs (lower levels can, and URLs hold private keys).
    access_log /var/log/nginx/santa-limits.log santa_limits if=$santa_limited;
    error_log /var/log/nginx/santa-error.log crit;

    # No compression: pages contain secrets (private links), and compressing
    # them over HTTPS invites BREACH-style attacks.
    gzip off;

    # Small, quick requests only.
    client_max_body_size 100k;
    client_body_buffer_size 100k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    large_client_header_buffers 4 8k;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_conn santa_conn 20;

    if ($request_method !~ ^(GET|HEAD|POST)$) {
        return 405;
    }

    # --- Static files, straight from disk ---
    root /var/www/santa-static;
    charset utf-8;

    location = / {
        limit_req zone=santa_general burst=40 nodelay;
        include snippets/santa-headers.conf;
        add_header Link '</static/fonts/mountains-of-christmas-700.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin' always;
        expires -1;
        try_files /$santa_lang/index.html =404;
    }
    location = /privacy {
        limit_req zone=santa_general burst=40 nodelay;
        include snippets/santa-headers.conf;
        add_header Link '</static/fonts/mountains-of-christmas-700.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin' always;
        expires -1;
        try_files /$santa_lang/privacy.html =404;
    }
    location /static/ {
        limit_req zone=santa_general burst=40 nodelay;
        include snippets/santa-headers.conf;
        expires 1d;
        try_files $uri =404;
    }
    location = /robots.txt {
        include snippets/santa-headers.conf;
        try_files $uri =404;
    }

    # When the app is down or restarting (502) or too slow (504): a page in
    # the visitor's language instead of nginx's own. The status is kept.
    error_page 502 504 /unavailable.html;
    location = /unavailable.html {
        internal;
        include snippets/santa-headers.conf;
        add_header Cache-Control "no-store" always; # "expires" skips error statuses
        try_files /$santa_lang/unavailable.html =502;
    }

    # --- Everything else: the app ---
    # The client's own X-Forwarded-For is replaced, so the app's login
    # throttling sees the real address. At most 100 requests in progress at
    # once in total, so a flood from many addresses can't swamp the app.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    location / {
        limit_req zone=santa_general burst=40 nodelay;
        limit_conn santa_total 100;
        proxy_pass http://127.0.0.1:8787;
    }
    location /admin {
        limit_req zone=santa_admin burst=20 nodelay;
        limit_conn santa_total 100;
        proxy_pass http://127.0.0.1:8787;
    }
    # The organiser's page works like /admin; the join link is shared widely.
    location /o/ {
        limit_req zone=santa_admin burst=20 nodelay;
        limit_conn santa_total 100;
        proxy_pass http://127.0.0.1:8787;
    }
    location /j/ {
        limit_req zone=santa_join burst=10 nodelay;
        limit_conn santa_total 100;
        proxy_pass http://127.0.0.1:8787;
    }
    location ~ ^/p/[^/]+/preview$ {
        limit_req zone=santa_lookup burst=10 nodelay;
        limit_conn santa_total 100;
        proxy_pass http://127.0.0.1:8787;
    }
}
{% endif %}
