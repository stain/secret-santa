# Managed by Ansible (deploy/site.yml). Podman Quadlet: systemd turns this
# into secret-santa.service, which runs the app container.

[Unit]
Description=Secret Santa
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/secret-santa:latest
ContainerName=secret-santa
EnvironmentFile=/etc/secret-santa/secret-santa.env
Environment=NODE_ENV=production PORT=8787 DATA_DIR=/data
# Only Caddy, on this host, can reach it.
PublishPort=127.0.0.1:8787:8787
# Database and nightly SQL dumps, owned by the container's node user (uid 1000).
Volume=/var/lib/secret-santa:/data
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PodmanArgs=--memory=256m --pids-limit=100
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
